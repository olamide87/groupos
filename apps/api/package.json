{
  "name": "@groupos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "test:db": "node scripts/test-database.mjs",
    "auth:deliver-recovery": "tsx src/auth/deliver-recovery.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "prisma": "6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
