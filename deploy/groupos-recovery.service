[Unit]
Description=GroupOS recovery delivery (example; requires operator configuration)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=groupos
Group=groupos
WorkingDirectory=/opt/groupos/apps/api
Environment=NODE_ENV=production
EnvironmentFile=/etc/groupos/recovery.env
ExecStart=/usr/bin/node --import tsx src/auth/deliver-recovery.ts
TimeoutStartSec=55
TimeoutStopSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
