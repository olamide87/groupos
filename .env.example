PORT=4100
API_BIND_HOST=127.0.0.1
# Production must explicitly choose direct or trusted. See docs/deployment.md.
API_PROXY_MODE=direct
# Trusted mode only: JSON array of exact proxy IPs, nearest to API first.
API_TRUSTED_PROXY_CHAIN=
# Choose separate local-only passwords and URL-encode them in the URLs below.
POSTGRES_PASSWORD=
POSTGRES_TEST_PASSWORD=
DATABASE_URL=postgresql://groupos:REPLACE_ME@127.0.0.1:5432/groupos
TEST_DATABASE_URL=postgresql://groupos_test:REPLACE_ME@127.0.0.1:5433/groupos_test

# Exact browser origin, without a trailing slash. HTTPS is mandatory in production.
AUTH_ORIGIN=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_RECOVERY_KEY=
# Production delivery adapter; leave unset for the private local development mailbox.
AUTH_RECOVERY_WEBHOOK_URL=
AUTH_RECOVERY_WEBHOOK_SECRET=
# Optional server-side Next.js rewrite target. Set in the web process environment;
# Next.js does not automatically load this root .env. Never use a browser-provided URL.
GROUPOS_API_ORIGIN=http://127.0.0.1:4100
# Set edge at frontend BUILD time in production; the edge routes /api/v1 directly.
GROUPOS_API_PROXY_MODE=local
